{
  "name": "@zeroclue/zeroclue-opencode-adapter",
  "version": "0.1.4",
  "description": "ZeroClue OpenCode adapter plugin for Paperclip — fork of opencode_local with explicit --dir binding (fixes session.directory inheriting the server process PWD)",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server/index.js",
    "./ui": "./dist/ui/index.js",
    "./ui-parser": "./dist/ui/parse-stdout.worker.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && cp src/ui/parse-stdout.worker.js dist/ui/parse-stdout.worker.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@paperclipai/adapter-utils": "^2026.824.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@10.33.0",
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "paperclip": {
    "adapterUiParser": "1"
  }
}